# =====================================================================
# FasalShield environment variables
# Copy to `.env` (never commit .env). Every variable used anywhere in
# the monorepo is listed here; the "Part" tag says which build part
# starts using it. Server vars are validated at startup by
# @fasalshield/shared/env (loadServerEnv) - the API refuses to boot
# with missing/invalid values.
# =====================================================================

# ---------- Runtime (Part 0.1) ----------
NODE_ENV=development
# local | dev | staging | prod   (prod forbids mock providers + simulator)
APP_ENV=local
LOG_LEVEL=debug

# ---------- API (Part 0.4) ----------
API_PORT=4000
API_BASE_URL=http://localhost:4000
# Comma-separated list of allowed browser origins (admin dashboard)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---------- Database & cache (Parts 0.2 / 0.3) ----------
POSTGRES_USER=fasalshield
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=fasalshield
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fasalshield:change-me-local-only@localhost:5432/fasalshield?schema=public
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---------- Object storage (Part 0.2; S3 in prod, MinIO locally) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=minio-local
S3_SECRET_ACCESS_KEY=change-me-local-only
S3_BUCKET_UPLOADS=fs-uploads
S3_BUCKET_EVIDENCE=fs-evidence
S3_BUCKET_RAW=fs-raw

# ---------- Auth (Phase 1) ----------
# Generate each secret with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_ACCESS_SECRET=replace-with-32+-byte-random-base64
JWT_REFRESH_SECRET=replace-with-another-32+-byte-random-base64
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
STAFF_ACCESS_TTL_SECONDS=600
STAFF_SESSION_MAX_SECONDS=28800
OTP_HMAC_SECRET=replace-with-32+-byte-random-base64
OTP_TTL_SECONDS=300
# TOTP issuer shown in authenticator apps
MFA_ISSUER=FasalShield

# ---------- PII protection (Phase 1 / Part 10.1) ----------
# 32-byte key, base64. Local/dev only - KMS envelope encryption in prod.
PII_ENCRYPTION_KEY_B64=replace-with-32-byte-random-base64
# HMAC pepper for phone/ID hashes used in duplicate detection
PII_HASH_PEPPER=replace-with-32+-byte-random-base64

# ---------- Provider switches (mock first, real later) ----------
# console | msg91 | gupshup
SMS_PROVIDER=console
# mock | meta
WHATSAPP_PROVIDER=mock
# mock | fcm
PUSH_PROVIDER=mock
# mock | razorpayx | cashfree
PAYMENT_PROVIDER=mock
# mock | digilocker
KYC_PROVIDER=mock
# simulator | chirps | imerg
WEATHER_PROVIDER=simulator
# Weather simulator + /simulator endpoints (must be false in prod)
ENABLE_SIMULATOR=true

# ---------- Provider credentials (empty while using mocks) ----------
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_WEBHOOK_SECRET=replace-with-32+-byte-random-base64
SMS_API_KEY=
SMS_SENDER_ID=FSHLD
WHATSAPP_API_TOKEN=
FCM_SERVICE_ACCOUNT_B64=
KYC_API_KEY=
NASA_EARTHDATA_TOKEN=

# ---------- Admin / demo (Part 5.5; replaced by staff login + MFA in Part 9.1) ----------
# Sent as the x-admin-key header to /api/v1/simulator/* and /api/v1/evaluations
ADMIN_API_KEY=replace-with-32+-byte-random-base64
# Local folder for evidence snapshots + embedded Postgres data (S3 WORM in prod)
DATA_DIR=.data
# Port for the embedded dev Postgres (npm run db:start)
EMBEDDED_PG_PORT=5432

# ---------- Payout policy (Phase 6) ----------
PAYOUT_AUTO_APPROVE_BATCH_LIMIT_PAISE=50000000
PAYOUT_AUTO_APPROVE_ITEM_LIMIT_PAISE=1000000
PAYOUT_SLA_HOURS=24

# ---------- Mobile app (Part 2.1) - EXPO_PUBLIC_* is bundled into the app, never put secrets here ----------
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
EXPO_PUBLIC_APP_ENV=local

# ---------- Admin dashboard (Part 9.1) - VITE_* is bundled into the web app, never put secrets here ----------
VITE_API_URL=http://localhost:4000
VITE_APP_ENV=local

# Next.js web app (server side only): where the Express API listens
API_URL=http://localhost:4000

# Demo deployments with no SMS provider: show the OTP on screen (forbidden when APP_ENV=prod)
DEMO_SHOW_OTP=false
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/v1/cron/daily (32+ random characters)
CRON_SECRET=
