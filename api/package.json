{
  "name": "@fasalshield/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:start": "tsx scripts/dev-db.ts",
    "db:migrate": "dotenv -e ../.env -- prisma migrate dev",
    "db:reset": "dotenv -e ../.env -- prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "prisma generate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "staff:create": "tsx scripts/create-staff.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fasalshield/shared": "*",
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "geotiff": "3.0.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.1.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "jest": "^29.7.0",
    "pino-pretty": "^13.2.0",
    "prisma": "^6.19.3",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3"
  }
}
